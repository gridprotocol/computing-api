apiVersion: apps/v1
kind: Deployment
metadata:
  name: mefs-provider
  labels:
    app.kubernetes.io/name: mefs-provider
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: mefs-provider
  template:
    metadata:
      labels:
        app.kubernetes.io/name: mefs-provider
    spec:
      nodeSelector:
        kubernetes.io/hostname: m20      
      containers:
      - name: mefs-provider
        image: memoio/mefs-provider:latest  # Use your Docker image
        ports:
        - containerPort: 4001
        imagePullPolicy: IfNotPresent
        env:
           - name: PASSWORD
             value: "memoriae"     
           - name: PRICE
             value: "250000"
           - name: GROUP
             value: "4"    
           - name: SWARM_PORT
             value: "4001"
           - name: DATA_PATH
             value: "/root/data"
        resources:
          requests:
            memory: "4Gi"
            cpu: "2"
        volumeMounts:
            - name: mefs-path
              mountPath: /root  # Path inside the container for models
            - name: mefs-data
              mountPath: /root/data  # Path inside the container for outputs
      volumes:
        - name: mefs-path
          hostPath:
            path: /root/memo_provider  # Host path to models
            type: Directory
        - name: mefs-data
          hostPath:
            path: /root/memo_provider_data  # Host path for outputs
            type: Directory
